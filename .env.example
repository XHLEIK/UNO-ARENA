# -----------------------------------------------------------------------------
# UNO ARENA environment variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local or any real key.
# -----------------------------------------------------------------------------

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon / publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only service-role key. Never expose this to the browser.
# When omitted, the app falls back to in-memory storage (development only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret for POST /api/maintenance/cleanup.
# Use a long random value, for example: openssl rand -hex 32
CLEANUP_SECRET=replace-with-a-long-random-value

# Optional: Supabase CLI access token. Used only by the Supabase CLI,
# not by the Next.js runtime.
SUPABASE_ACCESSTOKEN=
